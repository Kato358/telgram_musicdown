# telegram-musicdown config.yaml 示例（FR-CFG-01）
#
# 放到 <TGM_BASE_DIR>/data/config.yaml（源码运行 = ./data/config.yaml，Docker = 宿主机
# ./data/config.yaml），也就是数据目录里——它跟 SQLite/会话同一个卷，容器重建不会丢。
# 向导首次保存会自动创建这个文件，本示例只用于「先手工预置好再启动」。
# 旧版本放在 <TGM_BASE_DIR>/config.yaml 的文件首次启动会自动搬进 data/。
#
# 也可以完全不建这个文件：同名 TGM_* 环境变量优先级高于本文件，见文末「环境变量替代」。

# ── Telegram 密钥（必填）──────────────────────────────────────
# https://my.telegram.org 申请；bot_token 来自 @BotFather（可选，留空则仅用户登录）。
api_id: 123456
api_hash: 0123456789abcdef0123456789abcdef
bot_token: "123456789:AAExampleBotTokenReplaceMe"

# ── ChKSz 在线音源（可选）─────────────────────────────────────
# 不填走官方默认地址；自建部署改 base_url。
chksz_api_key: ""
chksz_base_url: https://api.chksz.com

# ── Web 控制台（可选）─────────────────────────────────────────
web_host: 127.0.0.1
web_port: 8787
# 登录口令；非 127.0.0.1 绑定且未设口令时仍会强制登录。
web_login_secret: ""
# false = 显式关闭登录（含 0.0.0.0 部署），自行承担暴露面。
web_login_enabled: true

# ── 部署路径（FR-CFG-02，可选）────────────────────────────────
# 相对值以运行目录（TGM_BASE_DIR）为基准，绝对路径原样使用。
save_directory: downloads
session_directory: data/sessions
temp_directory: data/temp

# ── 代理（FR-AUTH-03，可选）───────────────────────────────────
# User 与 Bot 共用；scheme 支持 socks5 / http。
proxy:
  enable_proxy: true
  scheme: socks5
  hostname: 127.0.0.1
  port: 1080
  username: null
  password: null

# ── 环境变量替代（可选）───────────────────────────────────────
# 只在 env 里给够，就不需要 data/config.yaml：同名键优先级更高，值留空 = 不覆盖文件。
#   TGM_API_ID / TGM_API_HASH / TGM_BOT_TOKEN
#   TGM_WEB_HOST / TGM_WEB_PORT / TGM_WEB_LOGIN_SECRET / TGM_WEB_LOGIN_ENABLED
#   TGM_CHKSZ_API_KEY / TGM_CHKSZ_BASE_URL
#   TGM_SAVE_DIRECTORY / TGM_SESSION_DIRECTORY / TGM_TEMP_DIRECTORY
#   TGM_PROXY_HOST / TGM_PROXY_PORT
